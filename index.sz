// serez-ai — high-level neural network library for Serez-Code
// Version 1.0.0
//
// Usage:
//   import "serez-ai"
//
// Layers:
//   Dense, Conv2D, MaxPool2D, Flatten, Embedding, LSTM, GRU,
//   MultiHeadAttention, LayerNorm, TransformerBlock
//
// Training:
//   MSE, BCE                          ← loss functions
//   Sequential                        ← model container (fit, fit_opt, fit_dl,
//                                        freeze, save, load, predict)
//   Adam, Momentum, SGD               ← optimizers
//
// Data:
//   DataLoader                        ← shuffled mini-batch iteration
//
// IO:
//   serializeTensor, deserializeTensor ← low-level tensor serialization

import "src/layers/dense"
import "src/layers/conv2d"
import "src/layers/pooling"
import "src/layers/flatten"
import "src/layers/embedding"
import "src/layers/recurrent"
import "src/attention/multihead"
import "src/attention/transformer"
import "src/training/losses"
import "src/training/adam"
import "src/data/loader"
import "src/io/serializer"
import "src/models/sequential"
