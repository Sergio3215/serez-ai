// Loss functions
//
// MSE.new()   → mean squared error loss: mean((pred - target)^2)
// BCE.new()   → binary cross-entropy: -mean(y*log(p) + (1-y)*log(1-p))

export public class MSE {
    public MSE() {}

    public forward(pred, target) {
        let diff = pred.sub(target)
        let sq   = diff.mul(diff)
        return sq.mean()
    }
}

export public class BCE {
    public BCE() {}

    // Numerically stable binary cross-entropy.
    // pred: Tensor with values in (0,1) (sigmoid output); target: 0.0/1.0 labels.
    // Delegates to the core's fused autodiff op (correct backward); a manual
    // log/mul reconstruction does NOT propagate gradients (.log() has no backward).
    public forward(pred, target) {
        return Autodiff.bceLoss(pred, target)
    }
}
