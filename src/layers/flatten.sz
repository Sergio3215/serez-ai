// Flatten — no learnable params; freeze/getWeights are no-ops

export public class Flatten {
    public Flatten() { this.frozen = false }

    public forward(x) {
        let s    = x.shape()
        let batch = s[0]
        let flat  = x.size() / batch
        return x.reshape([batch, flat])
    }

    public update(lr) { }
    public update_adam(lr, beta1, beta2, t) { }
    public update_momentum(lr, momentum) { }
    public freeze()   { this.frozen = true  }
    public unfreeze() { this.frozen = false }
    public getWeights() { return [] }
    public setWeights(ws) { }
}
