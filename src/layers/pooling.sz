// Pooling layers
//
// MaxPool2D(pool, stride)
//   forward(x): x[N,H,W,C] → [N, out_H, out_W, C]  (max pooling with autodiff)
//   update(lr): no-op (no learnable params)

export public class MaxPool2D {
    public MaxPool2D(int pool, int stride) {
        this.pool   = pool
        this.stride = stride
    }

    public forward(x) {
        return x.max_pool2d(this.pool, this.stride)
    }

    public update(lr) { }
}
