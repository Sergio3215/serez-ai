// Dense (fully connected) layer
//
// new Dense(in_features, out_features, activation)
//   forward(x)                   → Tensor
//   update(lr)                   → SGD update (skipped if frozen)
//   update_adam(lr, b1, b2, t)   → Adam update
//   update_momentum(lr, m)       → momentum SGD
//   freeze() / unfreeze()
//   getWeights()                 → [weights, bias]
//   setWeights([w, b])           → void

export public class Dense {
    public Dense(int in_features, int out_features, string activation) {
        let std = Math.sqrt(2.0 / in_features)
        this.weights    = Random.normalTensor([in_features, out_features], 0.0, std)
        this.bias       = Tensor.zeros([out_features])
        this.activation = activation
        this.frozen     = false
        this.mw = Tensor.zeros([in_features, out_features])
        this.vw = Tensor.zeros([in_features, out_features])
        this.mb = Tensor.zeros([out_features])
        this.vb = Tensor.zeros([out_features])
        this.pw = Tensor.zeros([in_features, out_features])
        this.pb = Tensor.zeros([out_features])
    }

    public forward(x) {
        let z = x.matmul(this.weights).broadcastAdd(this.bias)
        if (this.activation == "relu")    { return z.relu()    }
        if (this.activation == "sigmoid") { return z.sigmoid() }
        if (this.activation == "tanh")    { return z.tanh()    }
        return z
    }

    public update(lr) {
        if (this.frozen) { return }
        let dw = Autodiff.gradient(this.weights)
        let db = Autodiff.gradient(this.bias)
        this.weights = this.weights.sub(dw.scale(lr))
        this.bias    = this.bias.sub(db.scale(lr))
    }

    public update_adam(lr, beta1, beta2, t) {
        if (this.frozen) { return }
        let dw = Autodiff.gradient(this.weights)
        let db = Autodiff.gradient(this.bias)
        this.mw = this.mw.scale(beta1).add(dw.scale(1.0 - beta1))
        this.vw = this.vw.scale(beta2).add(dw.mul(dw).scale(1.0 - beta2))
        this.mb = this.mb.scale(beta1).add(db.scale(1.0 - beta1))
        this.vb = this.vb.scale(beta2).add(db.mul(db).scale(1.0 - beta2))
        let b1t = Math.pow(beta1, t)
        let b2t = Math.pow(beta2, t)
        let mw_hat = this.mw.scale(1.0 / (1.0 - b1t))
        let vw_hat = this.vw.scale(1.0 / (1.0 - b2t))
        let mb_hat = this.mb.scale(1.0 / (1.0 - b1t))
        let vb_hat = this.vb.scale(1.0 / (1.0 - b2t))
        let rows = this.weights.shape()[0]
        let cols = this.weights.shape()[1]
        let eps_w = Tensor.ones([rows * cols]).scale(0.0000001).reshape([rows, cols])
        let inv_w = vw_hat.sqrt().add(eps_w).pow(-1.0)
        this.weights = this.weights.sub(mw_hat.mul(inv_w).scale(lr))
        let nb = this.bias.shape()[0]
        let eps_b = Tensor.ones([nb]).scale(0.0000001)
        let inv_b = vb_hat.sqrt().add(eps_b).pow(-1.0)
        this.bias = this.bias.sub(mb_hat.mul(inv_b).scale(lr))
    }

    public update_momentum(lr, momentum) {
        if (this.frozen) { return }
        let dw = Autodiff.gradient(this.weights)
        let db = Autodiff.gradient(this.bias)
        this.pw = this.pw.scale(momentum).sub(dw.scale(lr))
        this.pb = this.pb.scale(momentum).sub(db.scale(lr))
        this.weights = this.weights.add(this.pw)
        this.bias    = this.bias.add(this.pb)
    }

    public freeze()   { this.frozen = true  }
    public unfreeze() { this.frozen = false }

    public getWeights() { return [this.weights, this.bias] }

    public setWeights(ws) {
        this.weights = ws[0]
        this.bias    = ws[1]
    }

    public parameters() { return [this.weights, this.bias] }
}
